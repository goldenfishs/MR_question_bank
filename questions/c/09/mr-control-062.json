    "chapter": "07 结构体与内存",
    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\ntypedef struct{long long id,stock;}Item;static int cmp(const void*a,const void*b){const Item*x=a,*y=b;return (x->id>y->id)-(x->id<y->id);}int main(void){int n,m,failed=0;Item a[100];if(scanf(\"%d%d\",&n,&m)!=2)return 0;for(int i=0;i<n;i++)if(scanf(\"%lld%lld\",&a[i].id,&a[i].stock)!=2)return 0;for(int i=0;i<m;i++){long long id,delta;if(scanf(\"%lld%lld\",&id,&delta)!=2)return 0;for(int j=0;j<n;j++)if(a[j].id==id){long long next=a[j].stock+delta;if(next<0)failed++;else a[j].stock=next;break;}}qsort(a,(size_t)n,sizeof a[0],cmp);printf(\"%d\\n\",failed);for(int i=0;i<n;i++)printf(\"%lld %lld\\n\",a[i].id,a[i].stock);return 0;}\n",
    "oracleNotes": "Independent Python per-id transaction application; rejected updates leave prior state untouched."
  }

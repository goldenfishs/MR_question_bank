    "chapter": "07 结构体与内存",
    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nint main(void){size_t n;unsigned int*a=NULL;int q;if(scanf(\"%zu\",&n)!=1)return 0;if(n){a=malloc(n*sizeof *a);if(!a)return 1;}for(size_t i=0;i<n;i++)if(scanf(\"%u\",&a[i])!=1){free(a);return 0;}if(scanf(\"%d\",&q)!=1){free(a);return 0;}while(q--){char op;size_t p,k;unsigned int x;if(scanf(\" %c%zu\",&op,&p)!=2){free(a);return 0;}if(op=='I'){if(scanf(\"%u\",&x)!=1){free(a);return 0;}unsigned int*tmp=realloc(a,(n+1)*sizeof *a);if(!tmp){free(a);return 1;}a=tmp;memmove(a+p+1,a+p,(n-p)*sizeof *a);a[p]=x;n++;}else{if(scanf(\"%zu\",&k)!=1){free(a);return 0;}if(n)memmove(a+p,a+p+k,(n-p-k)*sizeof *a);n-=k;}}printf(\"%zu\\n\",n);if(!n)puts(\"EMPTY\");else{for(size_t i=0;i<n;i++){if(i)putchar(' ');printf(\"%u\",a[i]);}putchar('\\n');}free(a);return 0;}\n",
    "oracleNotes": "Independent Python slice insertion/deletion, including empty buffers; C avoids zero-size realloc and preserves ownership on allocation failure."

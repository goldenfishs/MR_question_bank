    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nstatic int lower_ascii(int c){return c>='A'&&c<='Z'?c-'A'+'a':c;}int main(void){char a[3002],b[3002];if(!fgets(a,sizeof a,stdin)||!fgets(b,sizeof b,stdin))return 0;a[strcspn(a,\"\\n\")]='\\0';b[strcspn(b,\"\\n\")]='\\0';size_t i=0;while(a[i]&&b[i]&&lower_ascii((unsigned char)a[i])==lower_ascii((unsigned char)b[i]))i++;int x=lower_ascii((unsigned char)a[i]),y=lower_ascii((unsigned char)b[i]);printf(\"%d\\n\",(x>y)-(x<y));return 0;}\n",

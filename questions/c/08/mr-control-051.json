    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nint main(void){int n,src,dst,k;unsigned int a[1000];if(scanf(\"%d%d%d%d\",&n,&src,&dst,&k)!=4)return 0;for(int i=0;i<n;i++)if(scanf(\"%u\",&a[i])!=1)return 0;memmove(a+dst,a+src,(size_t)k*sizeof a[0]);for(int i=0;i<n;i++){if(i)putchar(' ');printf(\"%u\",a[i]);}putchar('\\n');return 0;}\n",

    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nint main(void){char s[1002];if(!fgets(s,sizeof s,stdin))return 0;s[strcspn(s,\"\\n\")]='\\0';size_t i=0;int negative=0;if(s[i]=='+'||s[i]=='-'){negative=s[i]=='-';i++;}if(!s[i]){puts(\"INVALID\");return 0;}long value=0,limit=negative?32768L:32767L;for(;s[i];i++){if(s[i]<'0'||s[i]>'9'){puts(\"INVALID\");return 0;}int digit=s[i]-'0';if(value>(limit-digit)/10){puts(\"INVALID\");return 0;}value=value*10+digit;}printf(\"%ld\\n\",negative?-value:value);return 0;}\n",

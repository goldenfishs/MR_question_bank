    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\nint main(void){\nlong long n;if(scanf(\"%lld\",&n)!=1)return 0;long long r=0;while(n>0){r=r*10+n%10;n/=10;}printf(\"%lld\\n\",r);\nreturn 0;\n}\n",

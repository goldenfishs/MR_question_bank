    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\nint main(void){\nlong n;long long a,b,x;if(scanf(\"%ld%lld%lld%lld\",&n,&a,&b,&x)!=4)return 0;for(long i=0;i<n;i++)x=(a*x+b)%1000003;printf(\"%lld\\n\",x);\nreturn 0;\n}\n",

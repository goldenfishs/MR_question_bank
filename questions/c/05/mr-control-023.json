    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\nint main(void){\nlong long l,r,p;if(scanf(\"%lld%lld%lld\",&l,&r,&p)!=3)return 0;long long count=0;for(long long t=l;t<=r;t++)if(t%p==0)count++;printf(\"%lld\\n\",count);\nreturn 0;\n}\n",

    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\nint main(void){\nlong long x,k,a,b,c,d;if(scanf(\"%lld%lld%lld%lld%lld%lld\",&x,&k,&a,&b,&c,&d)!=6)return 0;printf(\"%lld\\n\",x<k?a*x+b:c*x+d);\nreturn 0;\n}\n",

    "resourcesUrl": "https://en.cppreference.com/w/c/language/operator_logical.html",
    "kind": "document",
    "mechanicalProblem": {
      "type": "single_choice",
      "options": [
        "*p > 0 && p != NULL",
        "p != NULL && *p > 0",
        "p != NULL || *p > 0",
        "(*p > 0) & (p != NULL)"
      ],
      "answers": [
        "1"
      ],
      "explanation": "逻辑与 && 从左往右求值；左侧为假时不求值右侧，因此先检查 p 再解引用。",

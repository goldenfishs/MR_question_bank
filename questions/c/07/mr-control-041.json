    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nstatic int level(const long long*t,int m,long long x){int l=0,r=m;while(l<r){int mid=l+(r-l)/2;if(t[mid]<=x)l=mid+1;else r=mid;}return l;}int main(void){int m,n;long long t[100],x;if(scanf(\"%d%d\",&m,&n)!=2)return 0;for(int i=0;i<m;i++)if(scanf(\"%lld\",&t[i])!=1)return 0;for(int i=0;i<n;i++){if(scanf(\"%lld\",&x)!=1)return 0;if(i)putchar(' ');printf(\"%d\",level(t,m,x));}putchar('\\n');return 0;}\n",
    "oracleNotes": "Independent linear threshold count, while reference uses a reusable binary-search function."

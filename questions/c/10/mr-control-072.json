    "cReference": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\nint main(void){int n;unsigned int lo,hi;if(scanf(\"%d\",&n)!=1)return 0;while(n--){if(scanf(\"%u%u\",&lo,&hi)!=2)return 0;long value=(long)lo+256L*(long)hi;if(value>=32768L)value-=65536L;printf(\"%ld\\n\",value);}return 0;}\n",

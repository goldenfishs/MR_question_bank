  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <sstream>\n#include <set>\n#include <map>\n#include <queue>\n#include <deque>\n#include <stack>\n#include <numeric>\n#include <functional>\n#include <cmath>\n#include <climits>\n#include <utility>\nusing namespace std;\nvector<long long>parse(string s){replace(s.begin(),s.end(),'.',' ');istringstream in(s);vector<long long>a;long long x;while(in>>x)a.push_back(x);return a;}int main(){string x,y;cin>>x>>y;auto a=parse(x),b=parse(y);a.resize(max(a.size(),b.size()));b.resize(a.size());cout<<(a==b?0:a<b?-1:1)<<'\\n';}\n",

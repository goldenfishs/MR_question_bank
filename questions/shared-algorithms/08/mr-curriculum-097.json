  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <sstream>\n#include <set>\n#include <map>\n#include <queue>\n#include <deque>\n#include <stack>\n#include <numeric>\n#include <functional>\n#include <cmath>\n#include <climits>\n#include <utility>\nusing namespace std;\nint main(){int m,k;cin>>m>>k;vector<vector<long long>>a(m);priority_queue<pair<long long,pair<int,int>>,vector<pair<long long,pair<int,int>>>,greater<pair<long long,pair<int,int>>>>q;for(int i=0;i<m;i++){int n;cin>>n;a[i].resize(n);for(auto&x:a[i])cin>>x;if(n)q.push({a[i][0],{i,0}});}while(k--){auto p=q.top();q.pop();if(!k){cout<<p.first<<'\\n';break;}int i=p.second.first,j=p.second.second+1;if(j<(int)a[i].size())q.push({a[i][j],{i,j}});}}\n",
    "pythonReference": "import heapq\nm,k=map(int,input().split());a=[];h=[]\nfor i in range(m):\n    v=list(map(int,input().split()))[1:];a.append(v)\n    if v:heapq.heappush(h,(v[0],i,0))\nfor _ in range(k):\n    value,i,j=heapq.heappop(h)\n    if j+1<len(a[i]):heapq.heappush(h,(a[i][j+1],i,j+1))\nprint(value)\n"
  }

  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <sstream>\n#include <set>\n#include <map>\n#include <queue>\n#include <deque>\n#include <stack>\n#include <numeric>\n#include <functional>\n#include <cmath>\n#include <climits>\n#include <utility>\nusing namespace std;\nint main(){int n;cin>>n;vector<pair<long long,long long>>a(n);for(auto&p:a)cin>>p.first>>p.second;sort(a.begin(),a.end());long long ans=0,L=0,R=0;bool have=false;for(auto[l,r]:a){if(!have){L=l;R=r;have=true;}else if(l>R){ans+=R-L;L=l;R=r;}else R=max(R,r);}if(have)ans+=R-L;cout<<ans<<'\\n';}\n",
    "pythonReference": "n=int(input());a=sorted(tuple(map(int,input().split())) for _ in range(n));ans=0;right=None\nfor l,r in a:\n    if right is None or l>right:ans+=r-l;right=r\n    elif r>right:ans+=r-right;right=r\nprint(ans)\n"
  }

    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n,m,s,t;cin>>n>>m>>s>>t;--s;--t;vector<vector<pair<int,ll>>>g(n);while(m--){int u,v;ll w;cin>>u>>v>>w;g[--u].push_back({--v,w});}ll INF=4000000000000000000LL;vector<ll>d(2*n,INF);priority_queue<pair<ll,int>,vector<pair<ll,int>>,greater<pair<ll,int>>>q;d[2*s]=0;q.push({0,2*s});while(!q.empty()){auto[x,id]=q.top();q.pop();if(x!=d[id])continue;int u=id/2,k=id%2;for(auto[v,w]:g[u]){int nid=2*v+k;if(x+w<d[nid]){d[nid]=x+w;q.push({d[nid],nid});}if(!k&&x+w/2<d[2*v+1]){d[2*v+1]=x+w/2;q.push({d[2*v+1],2*v+1});}}}ll ans=min(d[2*t],d[2*t+1]);cout<<(ans==INF?-1:ans)<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));n,m,s,t=a[:4];g=[[] for _ in range(n)]\n    for i in range(m):\n        u,v,w=a[4+3*i:7+3*i];g[u-1].append((v-1,w))\n    inf=10**30;d=[inf]*(2*n);d[2*(s-1)]=0;q=[(0,2*(s-1))]\n    while q:\n        x,id=heapq.heappop(q)\n        if x!=d[id]:continue\n        u,k=divmod(id,2)\n        for v,w in g[u]:\n            nid=2*v+k\n            if x+w<d[nid]:d[nid]=x+w;heapq.heappush(q,(d[nid],nid))\n            if not k and x+w//2<d[2*v+1]:d[2*v+1]=x+w//2;heapq.heappush(q,(d[2*v+1],2*v+1))\n    ans=min(d[2*(t-1):2*t]);return -1 if ans==inf else ans\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"
  }

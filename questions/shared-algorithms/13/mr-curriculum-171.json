    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n,m,q;cin>>n>>m>>q;ll INF=4000000000000000000LL;vector<vector<ll>>d(n,vector<ll>(n,INF));for(int i=0;i<n;i++)d[i][i]=0;while(m--){int u,v;ll w;cin>>u>>v>>w;--u;--v;d[u][v]=min(d[u][v],w);}for(int k=0;k<n;k++)for(int i=0;i<n;i++)if(d[i][k]<INF)for(int j=0;j<n;j++)if(d[k][j]<INF)d[i][j]=min(d[i][j],d[i][k]+d[k][j]);while(q--){int u,v;cin>>u>>v;ll x=d[u-1][v-1];cout<<(x==INF?-1:x)<<'\\n';}\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));n,m,q=a[:3];inf=10**30;d=[[inf]*n for _ in range(n)]\n    for i in range(n):d[i][i]=0\n    for i in range(m):\n        u,v,w=a[3+3*i:6+3*i];d[u-1][v-1]=min(d[u-1][v-1],w)\n    for k in range(n):\n        dk=d[k]\n        for i in range(n):\n            di=d[i];x=di[k]\n            if x==inf:continue\n            for j in range(n):\n                if x+dk[j]<di[j]:di[j]=x+dk[j]\n    ans=[]\n    for i in range(q):\n        u,v=a[3+3*m+2*i:5+3*m+2*i];x=d[u-1][v-1];ans.append(-1 if x==inf else x)\n    return '\\n'.join(map(str,ans))\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"
  }

    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n,m,s;cin>>n>>m>>s;--s;vector<vector<pair<int,ll>>>g(n);while(m--){int u,v;ll w;cin>>u>>v>>w;g[--u].push_back({--v,w});}ll INF=4000000000000000000LL;vector<ll>d(n,INF);priority_queue<pair<ll,int>,vector<pair<ll,int>>,greater<pair<ll,int>>>q;d[s]=0;q.push({0,s});while(!q.empty()){auto[x,u]=q.top();q.pop();if(x!=d[u])continue;for(auto[v,w]:g[u])if(x+w<d[v]){d[v]=x+w;q.push({d[v],v});}}for(int i=0;i<n;i++){if(i)cout<<' ';cout<<(d[i]==INF?-1:d[i]);}cout<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));n,m,s=a[:3];g=[[] for _ in range(n)]\n    for i in range(m):\n        u,v,w=a[3+3*i:6+3*i];g[u-1].append((v-1,w))\n    inf=10**30;d=[inf]*n;d[s-1]=0;q=[(0,s-1)]\n    while q:\n        x,u=heapq.heappop(q)\n        if x!=d[u]:continue\n        for v,w in g[u]:\n            if x+w<d[v]:d[v]=x+w;heapq.heappush(q,(d[v],v))\n    return [-1 if x==inf else x for x in d]\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"

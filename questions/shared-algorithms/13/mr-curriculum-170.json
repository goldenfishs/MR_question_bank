  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n,m,k;cin>>n>>m>>k;vector<int>d(n,-1);queue<int>q;while(k--){int s;cin>>s;d[--s]=0;q.push(s);}vector<vector<int>>g(n);while(m--){int u,v;cin>>u>>v;--u;--v;g[u].push_back(v);g[v].push_back(u);}while(!q.empty()){int u=q.front();q.pop();for(int v:g[u])if(d[v]<0){d[v]=d[u]+1;q.push(v);}}for(int i=0;i<n;i++){if(i)cout<<' ';cout<<d[i];}cout<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));n,m,k=a[:3];sources=a[3:3+k];g=[[] for _ in range(n)]\n    for i in range(m):\n        u,v=a[3+k+2*i:5+k+2*i];u-=1;v-=1;g[u].append(v);g[v].append(u)\n    d=[-1]*n;q=collections.deque()\n    for s in sources:d[s-1]=0;q.append(s-1)\n    while q:\n        u=q.popleft()\n        for v in g[u]:\n            if d[v]<0:d[v]=d[u]+1;q.append(v)\n    return d\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"
  }

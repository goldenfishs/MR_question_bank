    "kind": "document",
    "mechanicalProblem": {
      "type": "single_choice",
      "options": [
        "prefix[4] + prefix[1]",
        "prefix[3] - prefix[0]",
        "prefix[3] - prefix[1]",
        "prefix[4] - prefix[1]"
      ],
      "answers": [
        "3"
      ],
      "explanation": "prefix[4]包含a[0]至a[3]，减去prefix[1]中的a[0]，结果为1+4+2=7。",

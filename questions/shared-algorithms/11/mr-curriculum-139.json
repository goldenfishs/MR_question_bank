  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n;cin>>n;vector<int>a(n);for(int &x:a)cin>>x;int end=0,far=0,ans=0;for(int i=0;i<n-1;i++){if(i>far){cout<<-1<<'\\n';return 0;}far=max(far,min(n-1,i+a[i]));if(i==end){if(far==end){cout<<-1<<'\\n';return 0;}ans++;end=far;if(end==n-1)break;}}cout<<ans<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    v=list(map(int,data.split()))[1:];end=far=ans=0\n    for i in range(len(v)-1):\n        if i>far:return -1\n        far=max(far,min(len(v)-1,i+v[i]))\n        if i==end:\n            if far==end:return -1\n            ans+=1;end=far\n            if end==len(v)-1:break\n    return ans\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"

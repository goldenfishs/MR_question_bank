  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nstring a,b;cin>>a>>b;vector<int>d(b.size()+1);iota(d.begin(),d.end(),0);for(int i=1;i<=(int)a.size();i++){vector<int>e(b.size()+1);e[0]=i;for(int j=1;j<=(int)b.size();j++)e[j]=min({d[j]+1,e[j-1]+1,d[j-1]+(a[i-1]!=b[j-1])});d=e;}cout<<d.back()<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a,b=data.split();d=list(range(len(b)+1))\n    for i,x in enumerate(a,1):\n        e=[i]+[0]*len(b)\n        for j,y in enumerate(b,1):e[j]=min(d[j]+1,e[j-1]+1,d[j-1]+(x!=y))\n        d=e\n    return d[-1]\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"

  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <sstream>\n#include <set>\n#include <map>\n#include <queue>\n#include <deque>\n#include <stack>\n#include <numeric>\n#include <functional>\n#include <cmath>\n#include <climits>\n#include <utility>\nusing namespace std;\nint main(){int n,x;cin>>n>>x;vector<int>f(n+1),seen(n+1);for(int i=1;i<=n;i++)cin>>f[i];int k=0;while(!seen[x]){seen[x]=1;k++;x=f[x];}cout<<k<<' '<<x<<'\\n';}\n",

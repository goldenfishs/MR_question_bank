    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <sstream>\n#include <set>\n#include <map>\n#include <queue>\n#include <deque>\n#include <stack>\n#include <numeric>\n#include <functional>\n#include <cmath>\n#include <climits>\n#include <utility>\nusing namespace std;\nlong long f(long long x,long long t,long long a,long long b,long long c,long long d){return x<t?a*x+b:c*x+d;}int main(){long long t,a,b,c,d,x;int q;cin>>t>>a>>b>>c>>d>>q;for(int i=0;i<q;i++){cin>>x;if(i)cout<<' ';cout<<f(x,t,a,b,c,d);}cout<<'\\n';}\n",

  "maintenance": {
    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint h,w;cin>>h>>w;vector<string>a(h);for(auto &s:a)cin>>s;vector<vector<vector<int>>>d(h,vector<vector<int>>(w,vector<int>(2,-1)));queue<vector<int>>q;d[0][0][0]=0;q.push({0,0,0});int dx[]={1,-1,0,0},dy[]={0,0,1,-1};while(!q.empty()){auto t=q.front();q.pop();int x=t[0],y=t[1],k=t[2];for(int z=0;z<4;z++){int u=x+dx[z],v=y+dy[z];if(u<0||u>=h||v<0||v>=w)continue;int nk=k+(a[u][v]=='#');if(nk<=1&&d[u][v][nk]<0){d[u][v][nk]=d[x][y][k]+1;q.push({u,v,nk});}}}int ans=-1;for(int k=0;k<2;k++)if(d[h-1][w-1][k]>=0&&(ans<0||d[h-1][w-1][k]<ans))ans=d[h-1][w-1][k];cout<<ans<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    v=data.split();h,w=map(int,v[:2]);a=v[2:];d=[[[-1]*2 for _ in range(w)] for _ in range(h)];d[0][0][0]=0;q=collections.deque([(0,0,0)])\n    while q:\n        x,y,k=q.popleft()\n        for u,v in [(x+1,y),(x-1,y),(x,y+1),(x,y-1)]:\n            if 0<=u<h and 0<=v<w:\n                nk=k+(a[u][v]==\"#\")\n                if nk<=1 and d[u][v][nk]<0:d[u][v][nk]=d[x][y][k]+1;q.append((u,v,nk))\n    ans=[x for x in d[-1][-1] if x>=0];return min(ans) if ans else -1\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"
  }

    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n;ll K;cin>>n>>K;vector<ll>a(n);for(auto &x:a)cin>>x;deque<int>mn,mx;int l=0,ans=0;for(int r=0;r<n;r++){while(!mn.empty()&&a[mn.back()]>=a[r])mn.pop_back();while(!mx.empty()&&a[mx.back()]<=a[r])mx.pop_back();mn.push_back(r);mx.push_back(r);while(a[mx.front()]-a[mn.front()]>K){if(mn.front()==l)mn.pop_front();if(mx.front()==l)mx.pop_front();l++;}ans=max(ans,r-l+1);}cout<<ans<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));K=a[1];v=a[2:];mn=collections.deque();mx=collections.deque();l=ans=0\n    for r,x in enumerate(v):\n        while mn and v[mn[-1]]>=x:mn.pop()\n        while mx and v[mx[-1]]<=x:mx.pop()\n        mn.append(r);mx.append(r)\n        while v[mx[0]]-v[mn[0]]>K:\n            if mn[0]==l:mn.popleft()\n            if mx[0]==l:mx.popleft()\n            l+=1\n        ans=max(ans,r-l+1)\n    return ans\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"
  }

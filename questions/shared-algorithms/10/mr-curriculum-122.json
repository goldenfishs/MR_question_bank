    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));h,w,q=a[:3];p=[[0]*(w+1) for _ in range(h+1)];t=3\n    for i in range(1,h+1):\n        for j in range(1,w+1):\n            p[i][j]=a[t]+p[i-1][j]+p[i][j-1]-p[i-1][j-1];t+=1\n    ans=[]\n    for _ in range(q):\n        x,y,u,v=a[t:t+4];t+=4;ans.append(p[u][v]-p[x-1][v]-p[u][y-1]+p[x-1][y-1])\n    return '\\n'.join(map(str,ans))\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"

    "referenceSolution": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n#include <queue>\n#include <deque>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <numeric>\n#include <functional>\n#include <utility>\n#include <limits>\n#include <cmath>\nusing namespace std;using ll=long long;\nint main(){ios::sync_with_stdio(false);cin.tie(nullptr);\nint n,k;cin>>n>>k;vector<ll>c(k);c[0]=1;ll p=0,ans=0;while(n--){ll x;cin>>x;p=((p+x)%k+k)%k;ans+=c[p]++;}cout<<ans<<'\\n';\n}\n",
    "pythonReference": "import sys,collections,heapq,itertools,functools,bisect\ndef solve(data):\n    a=list(map(int,data.split()));n,k=a[:2];c=[0]*k;c[0]=1;p=ans=0\n    for x in a[2:]:\n        p=(p+x)%k;ans+=c[p];c[p]+=1\n    return ans\n\nif __name__==\"__main__\":\n    a=solve(sys.stdin.buffer.read().decode())\n    print(\" \".join(map(str,a)) if isinstance(a,(list,tuple)) else a)\n"

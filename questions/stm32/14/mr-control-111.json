    "resourcesUrl": "https://www.st.com/resource/en/reference_manual/cd00171190-stm32f101xx-stm32f102xx-stm32f103xx-stm32f105xx-and-stm32f107xx-advanced-armbased-32bit-mcus-stmicroelectronics.pdf",
    "kind": "document",
    "mechanicalProblem": {
      "type": "single_choice",
      "options": [
        "000：完整SWJ",
        "001：仅去掉NJTRST",
        "010：关闭JTAG-DP，保留SW-DP",
        "100：JTAG-DP和SW-DP都关闭"
      ],
      "answers": [
        "2"
      ],
      "explanation": "010关闭JTAG、保留SWD，释放JTAG专用的PA15/PB3/PB4而保留PA13/PA14。001只释放NJTRST，不能满足释放全部三脚；100会失去SWD。SWJ_CFG是写专用字段，读回值未定义，不能依赖其读值判断当前配置。",
      "answerFileIds": []
    }
  },
